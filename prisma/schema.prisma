// Lean MVP schema. Deliberately smaller than docs/04-data-model.md:
// calendar, decks, audio rows and the usage ledger are cut for the MVP.
// Kept Postgres-portable (no SQLite-specific types), which is what made this
// datasource swap possible — see docs/03-architecture.md ADR-002 and ADR-011.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase's pooled (pgbouncer) connection can't run schema changes;
  // db push/migrate use the direct connection instead.
  directUrl = env("DIRECT_URL")
}

/// A dictionary word. Shared across every user — the dictionary is reference
/// data (built-in set plus the Ekilex cache), not anyone's personal deck.
/// See docs/03-architecture.md ADR-012. Cards, not Lexeme, are user-owned.
model Lexeme {
  id            String  @id @default(uuid())
  lemma         String
  pos           String // NOUN | VERB | ADJECTIVE | ADVERB | PHRASE | OTHER
  translation   String
  cefr          String? // A1 A2 B1 B2 C1 C2
  gradation     String  @default("NONE") // NONE | QUALITATIVE | QUANTITATIVE
  gradationNote String? // e.g. "b : ∅"
  government    String? // verb case government, e.g. "partitive — aitan sind"
  examples      String  @default("[]") // JSON: [{ et, en }]
  notes         String?
  provenance    String  @default("SEED") // SEED | EKILEX | AI | USER
  ekilexWordId  Int?

  /// Who last changed this entry by hand, when anyone did.
  ///
  /// The dictionary is shared (ADR-012), so a correction one learner makes is a
  /// correction everybody sees. That is the point — but it means an edit has to
  /// be attributable, or a bad one is untraceable.
  editedBy  String?
  editedAt  DateTime?
  fetchedAt DateTime? // when Ekilex was last consulted, for cache freshness

  forms     Form[]
  cards     Card[]
  stars     StarredWord[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([lemma, pos])
  @@index([lemma])
  @@index([cefr])
}

/// A user bookmarking a dictionary word. Per-user, unlike the word itself.
model StarredWord {
  ownerId   String
  lexemeId  String
  lexeme    Lexeme   @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([ownerId, lexemeId])
  @@index([ownerId])
}

/// An inflected form.
///
/// Two kinds live here. Principal parts (isPrincipal) are the unpredictable forms
/// a learner must memorise. Everything else is a full paradigm form retrieved from
/// Ekilex — authoritative, not derived, so storing it does not create a second
/// source of truth (ADR-009). Words we hold only principal parts for still get
/// their regular cases derived at render time.
model Form {
  id          String  @id @default(uuid())
  lexemeId    String
  lexeme      Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  formType    String // NOM_SG GEN_SG PART_SG ILL_SG_SHORT PART_PL GEN_PL | INF_MA INF_DA PRES_1SG PAST_1SG PART_TUD | EKILEX:<morphCode>
  value       String
  isPrincipal Boolean @default(true)
  morphCode   String? // Ekilex code, e.g. SgIn, PlKom, IndIpfSg1
  morphName   String? // Estonian label, e.g. "ainsuse seesütlev"
  orderIndex  Int     @default(0)

  // Estonian has genuine parallel forms (raamatutes / raamatuis), so the value
  // is part of the key — otherwise the second one silently overwrites the first.
  @@unique([lexemeId, formType, value])
  @@index([lexemeId])
}

model Card {
  id         String  @id @default(uuid())
  ownerId    String
  lexemeId   String?
  lexeme     Lexeme? @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  cardType   String // RECOGNITION PRODUCTION CASE_FORM GRADATION GOVERNMENT
  front      String
  back       String
  hint       String?
  targetCase String? // for CASE_FORM cards — powers the weak-case breakdown
  source     String  @default("MANUAL") // MANUAL | DICTIONARY | TUTOR | IMPORT
  suspended  Boolean @default(false)

  // FSRS state (ts-fsrs) — ADR-003
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0)
  scheduledDays Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0) // 0 New 1 Learning 2 Review 3 Relearning
  learningSteps Int       @default(0) // FSRS learning-step index; must round-trip
  lastReview    DateTime?

  /// The course week this word belongs to, mirroring Task.classWeek.
  ///
  /// On Card rather than Lexeme because it is a fact about one learner's course,
  /// not about the word: the same noun is week 3 for one person and week 11 for
  /// another, and Lexeme is the shared dictionary (ADR-012).
  classWeek Int?

  createdAt DateTime @default(now())

  @@index([ownerId, due, suspended])
  @@index([ownerId, classWeek])
  @@index([lexemeId])
}

/// Append-only. Never updated, never deleted — the one irreplaceable table.
///
/// It has no foreign key to Card, and that is the point. A `Card` relation with
/// `onDelete: Cascade` meant deleting a card silently deleted its history too,
/// so the invariant above was a comment rather than a property: suspending a
/// leech, or restoring a backup in replace mode, destroyed evidence that cannot
/// be reconstructed. `cardId` stays as a plain column so a review still groups
/// into a per-card sequence — which is what FSRS optimisation reads — while
/// outliving the card itself.
///
/// `ownerId` and `lexemeId` are denormalised for the same reason: a review has
/// to stay attributable and analysable once its card is gone. They also turn
/// every "my reviews" query from a join into an index lookup.
model Review {
  id          String   @id @default(uuid())
  ownerId     String
  cardId      String
  /// Null only for reviews restored from a backup written before this column.
  lexemeId    String?
  rating      Int // 1 Again · 2 Hard · 3 Good · 4 Easy
  reviewedAt  DateTime @default(now())
  durationMs  Int      @default(0)
  stateBefore Int      @default(0)
  targetCase  String?

  @@index([ownerId, reviewedAt])
  @@index([ownerId, targetCase])
  @@index([cardId])
  @@index([reviewedAt])
}

model Task {
  id          String    @id @default(uuid())
  ownerId     String
  title       String
  notes       String?
  tag         String    @default("HOMEWORK") // HOMEWORK GRAMMAR VOCABULARY LISTENING SPEAKING
  classWeek   Int?
  dueAt       DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([ownerId, completed, dueAt])
}

model Message {
  id        String   @id @default(uuid())
  ownerId   String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

model Setting {
  ownerId String
  key     String
  value   String

  @@id([ownerId, key])
}

/// A badge the learner has earned. Append-mostly: a key is written once, the
/// moment its condition is first met, and never removed — losing a badge you
/// already earned would be a worse surprise than never having shown it.
model Achievement {
  ownerId  String
  key      String
  earnedAt DateTime @default(now())

  @@id([ownerId, key])
}

/// A class: one teacher, a join code, and the learners who used it.
///
/// Deliberately thin. A classroom here is a *view* over data the learners
/// already own — nobody's cards, reviews or tasks move into it, and leaving a
/// class removes the membership row and nothing else. That keeps the promise
/// the app can actually make to a student: your deck is yours, and joining your
/// teacher's class shares your progress, not your data.
model Classroom {
  id        String   @id @default(uuid())
  name      String
  /// Six characters, shown to students to join with. Unique across the instance.
  code      String   @unique
  /// The teacher's user id.
  ownerId   String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  members ClassroomMember[]

  @@index([ownerId])
}

/// One learner's membership of one class.
model ClassroomMember {
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  ownerId     String
  role        String    @default("STUDENT") // TEACHER | STUDENT
  /// The name they chose to be known by here, copied at join time so a later
  /// change to their own display name does not silently rename them mid-term.
  displayName String
  joinedAt    DateTime  @default(now())

  @@id([classroomId, ownerId])
  @@index([ownerId])
}

/// One metered call to a paid third-party service.
///
/// Append-only like Review, and for a related reason: it is the evidence behind
/// the spend cap, and a ledger you can rewrite is not a ledger. Rows are keyed
/// by UTC day so the per-day aggregates the quota needs are one indexed count
/// rather than a scan.
model UsageEvent {
  id           String   @id @default(uuid())
  ownerId      String
  kind         String // TUTOR | GRADER | TTS
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// Estimated, in millionths of a USD. Integer on purpose — accumulated floats
  /// drift, and always in the direction of spending more than the cap allows.
  costMicros   Int      @default(0)
  /// UTC date, "YYYY-MM-DD". Denormalised so a day's usage is an index lookup.
  day          String
  createdAt    DateTime @default(now())

  @@index([ownerId, day])
  @@index([day])
  @@index([ownerId, createdAt])
}

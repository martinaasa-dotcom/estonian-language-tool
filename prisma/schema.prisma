// Lean MVP schema. Deliberately smaller than docs/04-data-model.md:
// decks and audio rows are cut. The calendar is `StudyEvent` below, added when
// a learner asked to keep their class times beside their homework.
// Kept Postgres-portable (no SQLite-specific types), which is what made this
// datasource swap possible — see docs/03-architecture.md ADR-002 and ADR-011.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase's pooled (pgbouncer) connection can't run schema changes;
  // db push/migrate use the direct connection instead.
  directUrl = env("DIRECT_URL")
}

/// A dictionary word. Shared across every user — the dictionary is reference
/// data (built-in set plus the Ekilex cache), not anyone's personal deck.
/// See docs/03-architecture.md ADR-012. Cards, not Lexeme, are user-owned.
model Lexeme {
  id            String  @id @default(uuid())
  lemma         String
  pos           String // NOUN | VERB | ADJECTIVE | ADVERB | PHRASE | OTHER
  translation   String
  cefr          String? // A1 A2 B1 B2 C1 C2
  gradation     String  @default("NONE") // NONE | QUALITATIVE | QUANTITATIVE
  gradationNote String? // e.g. "b : ∅"
  government    String? // verb case government, e.g. "partitive — aitan sind"
  examples      String  @default("[]") // JSON: [{ et, en }]
  notes         String?
  provenance    String  @default("SEED") // SEED | EKILEX | AI | USER
  ekilexWordId  Int?

  /// Who last changed this entry by hand, when anyone did.
  ///
  /// The dictionary is shared (ADR-012), so a correction one learner makes is a
  /// correction everybody sees. That is the point — but it means an edit has to
  /// be attributable, or a bad one is untraceable.
  editedBy  String?
  editedAt  DateTime?
  fetchedAt DateTime? // when Ekilex was last consulted *and answered*, for cache freshness

  /// When Ekilex was last asked about this word and had nothing to say.
  ///
  /// Separate from `fetchedAt` rather than folded into it, and the reason is
  /// `lib/progress/exam.ts`: the exam pool orders by `fetchedAt` as a proxy for
  /// "words the dictionary knows most about", so stamping a miss there would
  /// sort the least known words to the front of a mock paper. Two different
  /// facts had been sharing one column and only one of them was ever written.
  ///
  /// Nothing was written at all before this, which is the fault it fixes: a
  /// word Ekilex cannot answer for was re-asked, twice over, on every render of
  /// the page it appears on, for ever. The same class of bug as the one that
  /// cost four fifths of the dictionary on the seed's first run, and the same
  /// fix: a source that will not answer is written down as a miss.
  lookupMissAt DateTime?

  forms     Form[]
  cards     Card[]
  stars     StarredWord[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([lemma, pos])
  @@index([lemma])
  @@index([cefr])
}

/// A user bookmarking a dictionary word. Per-user, unlike the word itself.
model StarredWord {
  ownerId   String
  lexemeId  String
  lexeme    Lexeme   @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /*
    No separate index on `ownerId`. There was one, and the planner could never
    have chosen it: the composite primary key above is itself an index whose
    leading column is `ownerId`, so every query that would have wanted one
    uses that. All the extra index did was cost a second write on every star
    and unstar.
  */
  @@id([ownerId, lexemeId])
}

/// An inflected form.
///
/// Two kinds live here. Principal parts (isPrincipal) are the unpredictable forms
/// a learner must memorise. Everything else is a form retrieved from
/// Ekilex — authoritative, not derived, so storing it does not create a second
/// source of truth (ADR-009). Words we hold only principal parts for still get
/// their regular cases derived at render time.
model Form {
  id          String  @id @default(uuid())
  lexemeId    String
  lexeme      Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  formType    String // NOM_SG GEN_SG PART_SG ILL_SG_SHORT PART_PL GEN_PL | INF_MA INF_DA PRES_1SG PAST_1SG PART_TUD | EKILEX:<morphCode>
  value       String
  isPrincipal Boolean @default(true)
  morphCode   String? // Ekilex code, e.g. SgIn, PlKom, IndIpfSg1
  morphName   String? // Estonian label, e.g. "ainsuse seesütlev"
  orderIndex  Int     @default(0)

  // Estonian has genuine parallel forms (raamatutes / raamatuis), so the value
  // is part of the key — otherwise the second one silently overwrites the first.
  @@unique([lexemeId, formType, value])
  @@index([lexemeId])
}

model Card {
  id         String  @id @default(uuid())
  ownerId    String
  lexemeId   String?
  lexeme     Lexeme? @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  cardType   String // RECOGNITION PRODUCTION CASE_FORM GRADATION GOVERNMENT
  front      String
  back       String
  hint       String?
  targetCase String? // for CASE_FORM cards — powers the weak-case breakdown
  source     String  @default("MANUAL") // MANUAL | DICTIONARY | TUTOR | IMPORT
  suspended  Boolean @default(false)

  // FSRS state (ts-fsrs) — ADR-003
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0)
  scheduledDays Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0) // 0 New 1 Learning 2 Review 3 Relearning
  learningSteps Int       @default(0) // FSRS learning-step index; must round-trip
  lastReview    DateTime?

  /// The course week this word belongs to, mirroring Task.classWeek.
  ///
  /// On Card rather than Lexeme because it is a fact about one learner's course,
  /// not about the word: the same noun is week 3 for one person and week 11 for
  /// another, and Lexeme is the shared dictionary (ADR-012).
  classWeek Int?

  createdAt DateTime @default(now())

  @@index([ownerId, due, suspended])
  @@index([ownerId, classWeek])
  @@index([lexemeId])
}

/// Append-only. Never updated, never deleted — the one irreplaceable table.
///
/// It has no foreign key to Card, and that is the point. A `Card` relation with
/// `onDelete: Cascade` meant deleting a card silently deleted its history too,
/// so the invariant above was a comment rather than a property: suspending a
/// leech, or restoring a backup in replace mode, destroyed evidence that cannot
/// be reconstructed. `cardId` stays as a plain column so a review still groups
/// into a per-card sequence — which is what FSRS optimisation reads — while
/// outliving the card itself.
///
/// `ownerId` and `lexemeId` are denormalised for the same reason: a review has
/// to stay attributable and analysable once its card is gone. They also turn
/// every "my reviews" query from a join into an index lookup.
model Review {
  id          String   @id @default(uuid())
  ownerId     String
  cardId      String
  /// Null only for reviews restored from a backup written before this column.
  lexemeId    String?
  rating      Int // 1 Again · 2 Hard · 3 Good · 4 Easy
  reviewedAt  DateTime @default(now())
  durationMs  Int      @default(0)
  stateBefore Int      @default(0)
  targetCase  String?

  @@index([ownerId, reviewedAt])
  @@index([ownerId, targetCase])
  @@index([cardId])
  @@index([reviewedAt])
}

model Task {
  id          String    @id @default(uuid())
  ownerId     String
  title       String
  notes       String?
  tag         String    @default("HOMEWORK") // HOMEWORK GRAMMAR VOCABULARY LISTENING SPEAKING
  classWeek   Int?
  dueAt       DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([ownerId, completed, dueAt])
}

/// A learner's own Estonian calendar: a class, a study slot, an exam date.
///
/// Separate from `Task`, which is a to-do with a due date and is also what a
/// teacher assigns. An event happens *at* a time and often every week, and
/// overloading one model with both would mean every reader of either asking
/// which kind it had.
///
/// THE TIME IS MINUTES FROM MIDNIGHT, NOT A TIMESTAMP. A class at 18:00 every
/// Monday is at 18:00 in the learner's own zone in March and in November, and a
/// stored instant is not: it moves an hour when the clocks change. So a
/// repeating event stores a wall-clock minute and the weekdays it falls on, and
/// the learner's zone (`SETTING_KEYS.timeZone`) says what that means.
model StudyEvent {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  notes     String?
  /// CLASS STUDY EXAM OTHER. What it is, for the colour and the icon.
  kind      String   @default("CLASS")
  /// Minutes from local midnight, 0 to 1439.
  startMinute Int
  durationMinutes Int @default(60)
  /// Weekdays it repeats on, 0 Sunday to 6 Saturday. Empty for a one-off.
  weekdays  Int[]    @default([])
  /// A one-off's day, as `YYYY-MM-DD` in the learner's own zone. Null when it repeats.
  onDate    String?
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Message {
  id        String   @id @default(uuid())
  ownerId   String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

model Setting {
  ownerId String
  key     String
  value   String

  @@id([ownerId, key])
}

/// A badge the learner has earned. Append-mostly: a key is written once, the
/// moment its condition is first met, and never removed — losing a badge you
/// already earned would be a worse surprise than never having shown it.
model Achievement {
  ownerId  String
  key      String
  earnedAt DateTime @default(now())

  @@id([ownerId, key])
}

/// A class: one teacher, a join code, and the learners who used it.
///
/// Deliberately thin. A classroom here is a *view* over data the learners
/// already own — nobody's cards, reviews or tasks move into it, and leaving a
/// class removes the membership row and nothing else. That keeps the promise
/// the app can actually make to a student: your deck is yours, and joining your
/// teacher's class shares your progress, not your data.
model Classroom {
  id        String   @id @default(uuid())
  name      String
  /// Six characters, shown to students to join with. Unique across the instance.
  code      String   @unique
  /// The teacher's user id.
  ownerId   String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  members ClassroomMember[]

  @@index([ownerId])
}

/// One learner's membership of one class.
model ClassroomMember {
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  ownerId     String
  role        String    @default("STUDENT") // TEACHER | STUDENT
  /// The name they chose to be known by here, copied at join time so a later
  /// change to their own display name does not silently rename them mid-term.
  displayName String
  joinedAt    DateTime  @default(now())

  @@id([classroomId, ownerId])
  @@index([ownerId])
}

/// One metered call to a paid third-party service.
///
/// Append-only like Review, and for a related reason: it is the evidence behind
/// the spend cap, and a ledger you can rewrite is not a ledger. Rows are keyed
/// by UTC day so the per-day aggregates the quota needs are one indexed count
/// rather than a scan.
model UsageEvent {
  id           String   @id @default(uuid())
  ownerId      String
  kind         String // TUTOR | GRADER | TTS | SCAN
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// Estimated, in millionths of a USD. Integer on purpose — accumulated floats
  /// drift, and always in the direction of spending more than the cap allows.
  costMicros   Int      @default(0)
  /// UTC date, "YYYY-MM-DD". Denormalised so a day's usage is an index lookup.
  day          String
  createdAt    DateTime @default(now())

  /// `CALL` or `SETTLEMENT`.
  ///
  /// A cap that reads the ledger and then writes to it much later is a
  /// check-then-act race: ten tabs all read the same "under the limit" and all
  /// go ahead, and for a streamed answer the gap between the read and the
  /// write is the whole length of the answer. So a call is written down when
  /// it is authorised, at an estimate, and the tokens the provider actually
  /// reports arrive afterwards as a second row carrying the difference — which
  /// may be negative, because an estimate that was too high is a debt the
  /// learner does not owe.
  ///
  /// Two rows rather than an update, because this table is append-only for the
  /// same reason `Review` is: it is the evidence behind the cap, and a ledger
  /// you can rewrite is not a ledger. A settlement is a fact about a call, not
  /// a correction of the record that the call happened.
  ///
  /// Which is why the two are told apart at all: spend sums every row, and the
  /// call counts (the burst window, the daily allowance) count only `CALL`.
  /// Counting settlements as calls would silently halve every allowance in the
  /// app.
  entry        String   @default("CALL")

  @@index([ownerId, day])
  @@index([day])
  @@index([ownerId, createdAt])
}

/// One sitting of a mock state examination.
///
/// PROGRESS IS DERIVED, NEVER STORED, AND THIS IS ONE OF THE FEW EXCEPTIONS
/// THE RULE ALREADY ALLOWS: a value no log can reconstruct. The review log
/// records that a card was answered, not that it was answered under a clock, in
/// a paper of four parts, with the answers withheld until the end. Rebuild the
/// deck from the log and every one of those facts is gone, along with the only
/// number a learner deciding whether to book a real sitting actually wants.
///
/// Append-only in practice and treated as such: a sitting is written once, when
/// the paper is submitted, and never edited. An abandoned paper writes nothing
/// at all (ADR-016), which is why there is no row created at the start.
///
/// The grades the paper produced go to `Review` like every other mode's, so the
/// scheduler sees the sitting even though this table is the only place the
/// sitting itself is recorded.
model ExamAttempt {
  id      String @id @default(uuid())
  ownerId String
  /// A1 A2 B1 B2 C1 C2. The four the state examines, and the two this app adds.
  level   String
  /// The seed the paper was built from, so the same questions can be rebuilt.
  seed    String

  /// Weighted percentage, 0 to 100. Denormalised off `result` so the hub can
  /// rank six levels without parsing six JSON blobs.
  pct    Int
  passed Boolean

  /// The marked paper: per part, per task, per item, with what was expected and
  /// what was given. JSON because its shape belongs to `lib/exam/score.ts` and
  /// putting it in columns would be a second schema to keep in step with the
  /// first. Nothing queries inside it.
  result String

  startedAt  DateTime @default(now())
  finishedAt DateTime @default(now())

  @@index([ownerId, finishedAt])
  @@index([ownerId, level])
}

/// One page somebody photographed, after they confirmed what was on it.
///
/// THE PICTURE IS NOT HERE, AND THAT IS THE POINT. A photograph of homework
/// has a name at the top of it, and the app needs it for the four seconds it
/// takes to read the words off it. So the image is decoded in a route handler,
/// sent to one model, and dropped: what survives is the word list a person
/// looked at and ticked, which is the same thing the paste importer has always
/// kept. `lib/estonian/passage.ts` treats a pasted reading the same way.
///
/// Words are held as lemmas rather than as copies of dictionary rows, exactly
/// as a learning-path unit is (lib/collections/path.ts). A page is a *reference*
/// to vocabulary, so correcting a word in the shared dictionary corrects it on
/// every page it appears on, and a page can never drift out of step.
model Scan {
  id      String @id @default(uuid())
  ownerId String
  /// What the learner called it: "Page 42", "Tuesday's homework".
  title   String
  /// JSON: [{ et, en, lemma, lexemeId, matchedAs }]. `lexemeId` is null for a
  /// word that was read off the page and had no dictionary entry to vouch for it.
  items   String @default("[]")

  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

/// A placement check the learner sat: reading, listening, writing, speaking.
///
/// Stored, unlike everything else on the progress side of this app, and it is
/// worth saying why. XP, streaks and every chart are computed from the
/// append-only review log because a stored score is a second source of truth
/// that drifts. A placement result is not derivable from that log at all: it is
/// a measurement of answers to questions that were never cards and never
/// scheduled, made at one moment. Recomputing it later is impossible, so it is
/// kept, exactly like a personal best (ADR-014's stated exception).
///
/// Append-only in the same sense as Review: a row is written when the check
/// ends and never edited. A later check is a new row, which is what makes the
/// history a history rather than a number that moved.
model Assessment {
  id      String   @id @default(uuid())
  ownerId String
  takenAt DateTime @default(now())

  /// The weakest measured skill, which is what a CEFR level actually claims.
  /// "pre-A1" when the first band was not reached. Null if nothing was scored.
  overall    String?
  /// The strongest measured skill, so the result can say the true half too.
  ceiling    String?
  confidence String // rough | indicative | reasonable
  /// Scored questions answered. Speaking is not among them, by design.
  answered   Int     @default(0)

  reading      String?
  listening    String?
  writing      String?
  /// The learner's own rating of their speaking, 1 to 4, never a score of ours.
  /// There is no verified Estonian speech recogniser available here (ADR-018).
  speakingSelf Float?

  /// JSON: the per band breakdown, for the detail view and the next comparison.
  detail String @default("{}")

  @@index([ownerId, takenAt])
}

/// One thing a learner told us was wrong, and what they proposed instead.
///
/// THE DICTIONARY IS SHARED, SO DISAGREEING WITH IT HAS TO GO SOMEWHERE.
///
/// A learner can already correct an entry by hand, and that stays: it is
/// attributed, it is reversible, and it is the fastest way to fix a typo in
/// front of you. What it cannot carry is everything else that goes wrong — a
/// word the dictionary has never heard of, a gloss that is the wrong sense, a
/// sentence on a grammar page that is misleading, an answer marked wrong that
/// was right, a screen that threw. Before this, all of that had one honest
/// outcome and no second one: the learner read a dead end and closed the tab.
///
/// So every dead end in the app now offers to send one of these, and this is
/// where it lands. A row is a report *and*, where the category allows it, a
/// machine-applicable proposal (`patch`), so accepting it in the review queue
/// makes the change rather than opening a to-do.
///
/// `lexemeId` is a plain column with no relation, for the reason `Review`'s
/// `cardId` is: a report about a word has to outlive the word. Deleting or
/// merging an entry must not cascade away the evidence that it was wrong.
///
/// Owner-scoped, so it is in the export and goes with the account — the note
/// is the learner's own writing, and /privacy accounts for it.
model Suggestion {
  id      String @id @default(uuid())
  ownerId String

  /// OPEN | ACCEPTED | DECLINED.
  status   String @default("OPEN")
  /// One of `lib/suggestions/model.ts`'s categories. The queue's own tabs.
  category String

  /// What a thousand reports of one thing have in common.
  ///
  /// Sign-up is open and every failure in the app offers this button, so the
  /// queue's volume is a property of how many people meet the same dead end.
  /// Grouping is what keeps that reviewable: the admin sees one row saying
  /// "forty-one people", acts once, and the whole group resolves.
  groupKey String

  /// The dictionary entry this is about, when it is about one.
  lexemeId String?
  /// The word as the learner had it, which is the only handle a missing word has.
  lemma    String?

  /// The path they were on: "/dictionary?q=vihm", "/review".
  context String?
  /// What the app had just said to them. The failure they were looking at.
  trigger String?
  /// What they wrote.
  note    String  @default("")

  /// JSON: the proposal, in one of `lib/suggestions/model.ts`'s patch shapes,
  /// or `{}` where the category has nothing mechanical to apply. Every Estonian
  /// character in here was typed by a person, exactly like a hand edit — no
  /// model writes a form (ADR-005).
  patch   String  @default("{}")

  createdAt  DateTime  @default(now())
  reviewedBy String?
  reviewedAt DateTime?
  /// What the reviewer decided, in their words. Kept with the row so a second
  /// admin meeting the same report can see it was already answered and why.
  decision   String?

  @@index([status, category, createdAt])
  @@index([status, groupKey])
  @@index([ownerId, createdAt])
  @@index([lexemeId])
}

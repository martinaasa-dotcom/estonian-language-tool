# ─── Database ─────────────────────────────────────────── the only requirement
# Any Postgres will do. Locally that can be one on your own machine:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/kodukeel"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/kodukeel"
#
# Hosted (Vercel + Supabase): create a project at supabase.com, then use the
# dashboard's Connect panel. Both URLs come from the pooler.supabase.com host.
# Never use the direct db.<project-ref>.supabase.co host the dashboard offers
# first — it is IPv6-only and Vercel cannot reach it (P1001 on every build).
# DATABASE_URL is the transaction pooler (6543); ?pgbouncer=true is required
# or Prisma's prepared statements break against pgbouncer.
# DIRECT_URL is the session pooler (5432) — a full Postgres session, which is
# what lets `prisma db push` / `prisma migrate` run schema changes.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-1-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-1-region.pooler.supabase.com:5432/postgres"

# ─── Sign-in (Supabase Auth + Google) — OPTIONAL ───────────────────────────
# Leave both blank to run in local mode: one learner, no accounts, everything in
# the database above. Fill them in and the app becomes multi-user with Google
# sign-in and every route gated. See docs/03-architecture.md ADR-013.
# Same Supabase project as above. Project Settings → API for these two — the
# anon/publishable key is designed to be public, it only ever authenticates
# who is signed in; it is never used to read or write app data directly.
# Google OAuth itself is configured in the Supabase dashboard, not here —
# see README.md "Deploying it as a real website".
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ─── Anu, the AI tutor (optional) ──────────────────────────────────────────
# Get a key at https://openrouter.ai → Keys → Create Key
# Without it, every other part of the app still works; only the tutor is off.
OPENROUTER_API_KEY=""
# Any model slug from https://openrouter.ai/models.
# Measured on this project's Estonian grammar questions (scripts/eval-anu.mjs):
#   openai/gpt-4o          6/6  — recommended, roughly half a cent per question
#   anthropic/claude-sonnet-5  5/6
#   openai/gpt-4o-mini     5/6  — cheap, but invented a nonsense Estonian example
#   *:free models          too rate-limited upstream to rely on day to day
OPENROUTER_MODEL="openai/gpt-4o"

# ─── Ekilex dictionary (optional) ──────────────────────────────────────────
# Free key from https://ekilex.ee → register → profile → API.
# Without it the dictionary searches the ~200 built-in words only.
EKILEX_API_KEY=""

# ─── Who may sign in (optional) ────────────────────────────────────────────
# Leave both blank and sign-up is open to anyone with a Google account — the
# per-user AI quota below, not a guest list, is what keeps an open door from
# becoming an open bill. Set either one to turn this deployment into a private
# instance for a class or a family. Comma-separated; matched on the whole
# domain, so "kool.ee" does not admit "evilkool.ee".
ALLOWED_EMAILS=""
ALLOWED_EMAIL_DOMAINS=""

# ─── AI spend limits ───────────────────────────────────────────────────────
# Every one of these has a default; there is no way to turn metering off. The
# tutor is the only metered path — review, the dictionary and the deck are
# never limited. Set AI_DAILY_USD_GLOBAL="0" to stop AI spending entirely.
AI_BURST_CALLS="8"
AI_BURST_WINDOW_SECONDS="60"
AI_DAILY_CALLS_PER_USER="120"
AI_DAILY_USD_PER_USER="1.50"
AI_DAILY_USD_GLOBAL="20"

# ─── Shared audio cache (recommended when hosted) ──────────────────────────
# Without this, synthesised speech is cached on local disk — which on a
# serverless host is per-instance and wiped on every cold start, so every cold
# start re-asks TartuNLP for words it has already spoken. With it, one clip is
# fetched once for everyone, forever.
# Supabase dashboard → Project Settings → API → service_role key. SERVER ONLY:
# this key bypasses row-level security. CI fails the build if it reaches the
# browser bundle.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_AUDIO_BUCKET="audio"
